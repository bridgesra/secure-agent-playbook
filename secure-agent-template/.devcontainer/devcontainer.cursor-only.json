{
  "name": "Secure Cursor Sandbox",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "containerEnv": {
    "HEADROOM_BEACON": "off",
    "DO_NOT_TRACK": "1"
  },
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "Headroom dashboard",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-agent-tools.sh cursor",
  "postStartCommand": "bash .devcontainer/start-headroom.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "remoteUser": "vscode"
}
